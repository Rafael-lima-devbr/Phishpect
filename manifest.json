{
  "manifest_version": 3,
  "name": "Phishpect MVP",
  "version": "0.4.0",
  "description": "Analisa links localmente antes da navegação e alerta sobre URLs suspeitas.",
  "action": {
    "default_title": "Abrir testes do Phishpect",
    "default_popup": "test.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/tldts.umd.min.js", "analysis.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
