{
  "manifest_version": 3,
  "name": "Phishpect MVP",
  "version": "0.4.0",
  "description": "Analisa URLs e sinais estruturais das páginas localmente para alertar sobre riscos de phishing.",
  "action": {
    "default_title": "Abrir testes do Phishpect",
    "default_popup": "test.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/tldts.umd.min.js", "analysis.js", "page-analysis.js", "navigation-policy.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
