{
  "name": "phishpect-browser-extension",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "update-threat-db": "node scripts/update-threat-database.js",
    "build-evaluation-dataset": "node scripts/build-evaluation-dataset.js",
    "evaluate": "node scripts/evaluate-dataset.js",
    "evaluate:v2": "node scripts/evaluate-dataset.js --analyzer=v2",
    "evaluate:v3": "node scripts/evaluate-dataset.js --analyzer=v3",
    "evaluate:v3.1": "node scripts/evaluate-dataset.js --analyzer=v3.1",
    "benchmark": "node scripts/benchmark-analysis.js",
    "test:v2": "node tests/analysis-v2.test.js",
    "test:v3": "node tests/analysis-v3.test.js",
    "test:v3.1": "node tests/analysis-v3-1.test.js",
    "test:page": "node tests/page-analysis.test.js && node tests/combined-analysis.test.js",
    "test:navigation": "node tests/navigation-policy.test.js && node tests/navigation-state.test.js",
    "test:reputation": "node tests/reputation.test.js",
    "test:privacy": "node tests/privacy.test.js",
    "test": "node tests/analysis-v2.test.js && node tests/analysis-v3.test.js && node tests/analysis-v3-1.test.js && node tests/page-analysis.test.js && node tests/combined-analysis.test.js && node tests/reputation.test.js && node tests/navigation-policy.test.js && node tests/navigation-state.test.js && node tests/privacy.test.js"
  },
  "dependencies": {
    "tldts": "^7.4.16"
  }
}
